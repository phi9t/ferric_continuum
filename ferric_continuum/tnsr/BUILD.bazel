load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc", "rust_library", "rust_test")

# Core tensor/autograd/checkpointing library (CPU-only, f32, no external deps)
rust_library(
    name = "tnsr",
    srcs = [
        "src/lib.rs",
        "src/autograd.rs",
        "src/checkpoint.rs",
        "src/debug.rs",
        "src/grad_mode.rs",
        "src/saved.rs",
        "src/tensor.rs",
        "src/transformer.rs",
        "src/ops/mod.rs",
        "src/ops/activations.rs",
        "src/ops/attention.rs",
        "src/ops/basic.rs",
        "src/ops/embedding.rs",
        "src/ops/linear.rs",
        "src/ops/loss.rs",
        "src/ops/norm.rs",
        "src/scaling/mod.rs",
        "src/scaling/model_stats.rs",
        "src/scaling/op_cost.rs",
        "src/scaling/report.rs",
        "src/scaling/roofline.rs",
        "src/scaling/sharding.rs",
        "src/scaling/inference.rs",
        "src/scaling/parallelism.rs",
    ],
    crate_name = "tnsr",
    edition = "2021",
    visibility = ["//visibility:public"],
)

# End-to-end demo: no-checkpoint / whole-block / selective, emits /tmp/block.dot
rust_binary(
    name = "tnsr_demo",
    srcs = ["src/main.rs"],
    crate_name = "tnsr_demo",
    edition = "2021",
    deps = [
        ":tnsr",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
    ],
)

# Integration tests: gradient checks, checkpoint correctness, shape panics
rust_test(
    name = "tnsr_tests",
    srcs = ["tests/autograd_test.rs"],
    crate_name = "autograd_test",
    edition = "2021",
    deps = [":tnsr"],
)

# Golden-value tests for the scaling / FLOPs accounting module
rust_test(
    name = "scaling_tests",
    srcs = ["tests/scaling_test.rs"],
    crate_name = "scaling_test",
    edition = "2021",
    deps = [":tnsr"],
)

# API documentation
rust_doc(
    name = "tnsr_doc",
    crate = ":tnsr",
)
