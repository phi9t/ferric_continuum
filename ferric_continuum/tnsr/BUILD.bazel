load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc", "rust_library", "rust_test")

# Matches `--config=cuda` / `@rules_cuda//cuda:enable=True`.
config_setting(
    name = "enable_cuda",
    flag_values = {"@rules_cuda//cuda:enable": "True"},
)

_TNSR_SRCS = [
    "src/lib.rs",
    "src/autograd.rs",
    "src/checkpoint.rs",
    "src/cuda_ffi.rs",
    "src/debug.rs",
    "src/grad_mode.rs",
    "src/inference.rs",
    "src/saved.rs",
    "src/tensor.rs",
    "src/transformer.rs",
    "src/qwen3.rs",
    "src/qwen3_load.rs",
    "src/bpe.rs",
    "src/ops/mod.rs",
    "src/ops/activations.rs",
    "src/ops/attention.rs",
    "src/ops/basic.rs",
    "src/ops/context_parallel_gqa.rs",
    "src/ops/embedding.rs",
    "src/ops/gqa.rs",
    "src/ops/linear.rs",
    "src/ops/loss.rs",
    "src/ops/norm.rs",
    "src/ops/rope.rs",
    "src/ops/shape.rs",
    "src/scaling/mod.rs",
    "src/scaling/model_stats.rs",
    "src/scaling/op_cost.rs",
    "src/scaling/report.rs",
    "src/scaling/roofline.rs",
    "src/scaling/sharding.rs",
    "src/scaling/inference.rs",
    "src/scaling/distributed/mod.rs",
    "src/scaling/distributed/collectives.rs",
    "src/scaling/distributed/mesh.rs",
    "src/scaling/distributed/data_parallel.rs",
    "src/scaling/distributed/fsdp.rs",
    "src/scaling/distributed/tensor_parallel.rs",
    "src/scaling/distributed/pipeline.rs",
    "src/scaling/distributed/report.rs",
]

# Core tensor/autograd/checkpointing library (f32). Default CPU build needs no
# CUDA. With `--config=cuda`, crate feature `cuda` links cuda_kernels and uses
# GPU forward for matmul + softmax (host↔device convenience ABI).
rust_library(
    name = "tnsr",
    srcs = _TNSR_SRCS,
    crate_features = select({
        ":enable_cuda": ["cuda"],
        "//conditions:default": [],
    }),
    crate_name = "tnsr",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:half",
        "@crates//:memmap2",
        "@crates//:safetensors",
        "@crates//:serde_json",
    ] + select({
        ":enable_cuda": [
            "//ferric_continuum/cuda_kernels:gemm",
            "//ferric_continuum/cuda_kernels:headers",
            "//ferric_continuum/cuda_kernels:softmax",
        ],
        "//conditions:default": [],
    }),
)

# End-to-end demo: no-checkpoint / whole-block / selective, emits /tmp/block.dot
rust_binary(
    name = "tnsr_demo",
    srcs = ["src/main.rs"],
    crate_name = "tnsr_demo",
    edition = "2021",
    deps = [
        ":tnsr",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
    ],
)

