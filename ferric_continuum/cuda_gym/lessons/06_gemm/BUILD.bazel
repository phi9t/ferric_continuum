# Lesson 06 — GEMM: thin demo/test over the shared cuda_kernels GEMM.
#
#     bazel run  --config=cuda //ferric_continuum/cuda_gym/lessons/06_gemm:gemm_demo
#     bazel test --config=cuda //ferric_continuum/cuda_gym/lessons/06_gemm:gemm_test

load("@rules_cuda//cuda:defs.bzl", "cuda_binary", "cuda_test")

package(default_visibility = ["//visibility:public"])

cuda_binary(
    name = "gemm_demo",
    srcs = ["gemm_demo.cu"],
    tags = [
        "cuda",
        "requires-gpu",
    ],
    deps = [
        "//ferric_continuum/cuda_kernels:gemm",
        "//ferric_continuum/cuda_kernels:headers",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:globals",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/strings",
    ],
)

cuda_test(
    name = "gemm_test",
    srcs = ["gemm_test.cu"],
    tags = [
        "cuda",
        "requires-gpu",
    ],
    deps = [
        "//ferric_continuum/cuda_kernels:gemm",
        "//ferric_continuum/cuda_kernels:headers",
        "@googletest//:gtest_main",
    ],
)
