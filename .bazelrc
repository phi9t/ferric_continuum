# Ferric Continuum Bazel Configuration

###############################################################################
# Common flags
###############################################################################

# Use Bzlmod (modern module system)
common --enable_bzlmod

# Enable platform-specific config
build --enable_platform_specific_config

# Use a static value for PATH and LD_LIBRARY_PATH
build --incompatible_strict_action_env

# Do not leak the host environment into actions; keep builds hermetic.
build --experimental_reuse_sandbox_directories
build --sandbox_default_allow_network=false

# Output details
build --verbose_failures
build --show_timestamps

# Surface the reason a target failed to build without re-running.
build --announce_rc

# Performance optimizations
build --jobs=auto
build --local_resources=cpu=HOST_CPUS*.75

###############################################################################
# C++ Configuration
###############################################################################

# C++ standard
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# The LLVM toolchain links libstdc++ (see `stdlib` in MODULE.bazel). libstdc++
# does not ship the clang module map that Bazel's `layering_check` /
# `use_module_maps` features rely on (that map assumes libc++), so disable them
# globally. Bazel does not support C++ modules yet, so this only removes an
# unused strictness check and avoids "module 'crosstool' ... not provided".
build --features=-layering_check
build --features=-module_maps

# Compiler warnings
build --copt=-Wall
build --copt=-Wextra
build --host_copt=-Wall
build --host_copt=-Wextra

# Security hardening (applied to optimized/CI builds where NDEBUG-style codegen
# is expected). These make miscompiles and memory bugs fail loudly and shrink
# the exploitable surface of release artifacts.
build:hardened --copt=-fstack-protector-strong
build:hardened --copt=-fstack-clash-protection
build:hardened --copt=-U_FORTIFY_SOURCE
build:hardened --copt=-D_FORTIFY_SOURCE=2
build:hardened --copt=-fPIE
build:hardened --copt=-Wformat
build:hardened --copt=-Wformat-security
build:hardened --copt=-Werror=format-security
build:hardened --linkopt=-pie
build:hardened --linkopt=-Wl,-z,relro
build:hardened --linkopt=-Wl,-z,now
build:hardened --linkopt=-Wl,-z,noexecstack

# Color diagnostics
build --copt=-fdiagnostics-color=always
build --host_copt=-fdiagnostics-color=always

# Optimization flags
build:opt --compilation_mode=opt
build:opt --copt=-O3
build:opt --copt=-DNDEBUG

# Debug configuration
build:debug --compilation_mode=dbg
build:debug --copt=-g
build:debug --strip=never

# Fast build configuration
build:fastbuild --compilation_mode=fastbuild

# Address sanitizer
build:asan --strip=never
build:asan --copt=-fsanitize=address
build:asan --copt=-DADDRESS_SANITIZER
build:asan --copt=-O1
build:asan --copt=-g
build:asan --copt=-fno-omit-frame-pointer
build:asan --linkopt=-fsanitize=address

# Thread sanitizer
build:tsan --strip=never
build:tsan --copt=-fsanitize=thread
build:tsan --copt=-DTHREAD_SANITIZER
build:tsan --copt=-O1
build:tsan --copt=-g
build:tsan --copt=-fno-omit-frame-pointer
build:tsan --linkopt=-fsanitize=thread

# Undefined behavior sanitizer
build:ubsan --strip=never
build:ubsan --copt=-fsanitize=undefined
build:ubsan --copt=-fno-sanitize-recover=all
build:ubsan --copt=-DUNDEFINED_BEHAVIOR_SANITIZER
build:ubsan --copt=-O1
build:ubsan --copt=-g
build:ubsan --copt=-fno-omit-frame-pointer
build:ubsan --linkopt=-fsanitize=undefined
build:ubsan --test_env=UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1

###############################################################################
# Rust Configuration
###############################################################################

# Rust optimization
build:opt --@rules_rust//:rustc_opt_level=3

# Rust debug
build:debug --@rules_rust//:rustc_opt_level=0
build:debug --@rules_rust//:rustc_debug=true

# Clippy (Rust linter)
build:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:clippy --output_groups=+clippy_checks

# Rustfmt
build:rustfmt --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build:rustfmt --output_groups=+rustfmt_checks

###############################################################################
# Code Quality - Clang-Tidy Configuration
###############################################################################

# Clang-tidy (requires @bazel_clang_tidy in MODULE.bazel or WORKSPACE)
# Uncomment when clang-tidy aspect is set up:
# build:clang-tidy --aspects=@bazel_clang_tidy//clang_tidy:clang_tidy.bzl%clang_tidy_aspect
# build:clang-tidy --output_groups=report

###############################################################################
# CI/CD Configuration
###############################################################################

# CI build - treat warnings as errors
build:ci --copt=-Werror
build:ci --host_copt=-Werror
build:ci --compilation_mode=opt
build:ci --config=hardened
# Report every failure in a CI run rather than stopping at the first.
build:ci --keep_going
# Fail the build if any sanitizer reports leak at exit in CI.
test:ci --test_env=ASAN_OPTIONS=detect_leaks=1:halt_on_error=1

###############################################################################
# Python Configuration
###############################################################################

# Use Python 3.12 by default
build --@rules_python//python/config_settings:python_version=3.12

###############################################################################
# CUDA Configuration
###############################################################################

# Convenient flag aliases for rules_cuda knobs.
build --flag_alias=cuda_archs=@rules_cuda//cuda:archs
build --flag_alias=cuda_compiler=@rules_cuda//cuda:compiler
build --flag_alias=cuda_enable=@rules_cuda//cuda:enable

# CUDA is OFF by default so CPU-only builds and CI stay hermetic and require no
# toolkit. This also disables the auto-detected CUDA toolchains, preventing
# accidental use of a host toolkit.
build --@rules_cuda//cuda:enable=False

# Exclude CUDA-tagged targets from default wildcards so CPU CI (`bazel build
# //...`, `bazel test //...`) never analyzes cuda_library rules (which fail
# when `@rules_cuda//cuda:enable=False`). Explicit labels still honor this
# filter; use `--config=cuda` (which replaces these filters below).
build --build_tag_filters=-cuda
test --test_tag_filters=-cuda

# Opt in with `--config=cuda`. Override the target arch list on the command
# line, e.g. `--config=cuda --cuda_archs=compute_80:compute_80,sm_80`.
#
# Last --build_tag_filters / --test_tag_filters wins, so this replaces the
# default `-cuda` exclusion and allows CUDA-tagged wildcards. Student `:grade`
# targets keep the Bazel `manual` tag so wildcards skip them while explicit
# labels still run (they fail until student.cu is filled).
build:cuda --build_tag_filters=
test:cuda --test_tag_filters=
build:cuda --@rules_cuda//cuda:enable=True
# Default to nvcc; switch to clang with `--cuda_compiler=clang`. nvcc uses the
# registered LLVM clang as its host compiler (`-ccbin`). The LLVM toolchain is
# configured to link libstdc++ (see `stdlib` in MODULE.bazel), NOT libc++:
# CUDA 13.x rejects libc++ on x86 ("libc++ is not supported on x86 system"), and
# a single stdlib across CPU and CUDA objects avoids std::__1 vs std::__cxx11
# ABI clashes when a cuda_test links C++ deps such as gtest.
build:cuda --@rules_cuda//cuda:compiler=nvcc
# CUDA runtime: dynamic cudart WITHOUT cudadevrt. Our kernels do not use
# relocatable device code (rdc), so the device runtime (`cudadevrt`, needed only
# for JIT/device linking of rdc objects) is unnecessary. The default runtime
# whole-archives `cudadevrt`, whose `__cudaRegisterAll` pulls in an
# `__cudaRegisterLinkedBinary_*` symbol that only a device-link step provides —
# fine for cuda_binary/cuda_test, but it breaks when Rust (tnsr's `cuda` feature)
# links the kernel archives directly. `cudart_so` avoids devrt entirely and works
# for C++ demos/tests and the Rust FFI alike.
build:cuda --@rules_cuda//cuda:runtime=@cuda//:cudart_so
# Multi-arch default covering Ampere..Blackwell plus PTX for forward
# compatibility. compute_70 (Volta) is intentionally dropped: CUDA 13.x removed
# support for it ("Unsupported gpu architecture 'compute_70'"). sm_100 targets
# Blackwell / B200. Trim this list for faster builds targeting a single GPU,
# e.g. `--cuda_archs=compute_100:sm_100`.
build:cuda --@rules_cuda//cuda:archs=compute_80:compute_80,sm_80;compute_86:sm_86;compute_90:compute_90,sm_90;compute_100:compute_100,sm_100

# nvcc uses PIDs for temp-file names; under the Linux sandbox those collide at
# high parallelism ("No such file or directory" from cc1plus). A hermetic /tmp
# per sandbox avoids it (default on Bazel 7+, set explicitly for safety).
build:cuda --incompatible_sandbox_hermetic_tmp

###############################################################################
# Testing Configuration
###############################################################################

# Test output
test --test_output=errors
test --test_summary=detailed

# Test environment
test --test_env=RUST_BACKTRACE=1

# Coverage
coverage --combined_report=lcov
coverage --experimental_generate_llvm_lcov

###############################################################################
# Platform-Specific Configuration
###############################################################################

# macOS
build:macos --cxxopt=-stdlib=libc++
build:macos --linkopt=-lc++

# Linux - the registered LLVM/Clang toolchain links libstdc++ (see `stdlib` in
# MODULE.bazel) so that CPU and CUDA objects share one C++ ABI. No libc++ flags
# are attached to the always-on `build:linux` block: `--cxxopt`/`--linkopt` are
# additive and cannot be removed by a later config, and rules_cuda forwards the
# whole C++ cxxopts fragment to nvcc's host compiler, where CUDA 13.x rejects
# `-stdlib=libc++` on x86.
#
# `--config=libcxx` remains available for CPU-only builds that specifically want
# libc++, but must never be combined with `--config=cuda`.
build:libcxx --cxxopt=-stdlib=libc++
build:libcxx --linkopt=-lc++
build:libcxx --linkopt=-lc++abi
build:libcxx --host_cxxopt=-stdlib=libc++
build:libcxx --host_linkopt=-lc++
build:libcxx --host_linkopt=-lc++abi

###############################################################################
# Remote Execution / Caching (disabled by default)
###############################################################################

# Uncomment and configure for remote build execution
# build:remote --remote_executor=grpc://your-remote-executor:port
# build:remote --remote_cache=grpc://your-cache:port

###############################################################################
# User overrides
###############################################################################

# Load user-specific Bazel configuration if it exists
try-import %workspace%/.bazelrc.user

