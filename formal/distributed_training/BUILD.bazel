load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:private"])

# The MeshPlan formal models and their TLC configs. MeshPlan.tla is the shared
# base module that MeshPlanGood/MeshPlanBad `INSTANCE`, so all three .tla files
# must land in the same runfiles directory.
filegroup(
    name = "mesh_plan_models",
    srcs = [
        "MeshPlan.tla",
        "MeshPlanBad.cfg",
        "MeshPlanBad.tla",
        "MeshPlanGood.cfg",
        "MeshPlanGood.tla",
    ],
    visibility = ["//visibility:public"],
)

exports_files([
    "MeshPlan.tla",
    "MeshPlanGood.tla",
    "MeshPlanGood.cfg",
    "MeshPlanBad.tla",
    "MeshPlanBad.cfg",
    "README.org",
])

# The StepTxn formal models and their TLC configs. StepTxn.tla is the shared
# Layer-0 step-transaction contract that StepTxnGood `INSTANCE`s; StepTxnBad is
# a self-contained buggy variant. All must land in the same runfiles directory.
filegroup(
    name = "step_txn_models",
    srcs = [
        "StepTxn.tla",
        "StepTxnBad.cfg",
        "StepTxnBad.tla",
        "StepTxnGood.cfg",
        "StepTxnGood.tla",
    ],
    visibility = ["//visibility:public"],
)

# The mesh-trace -> StepTxn refinement bridge (issue 08). trace_bridge.py
# translates a recorded tnsr.mesh_sim_trace.v0 JSON into a self-contained TLA+
# behavior module that drives StepTxn.tla along the observed step.
py_library(
    name = "trace_bridge",
    srcs = ["trace_bridge.py"],
    imports = ["../.."],
    visibility = ["//visibility:public"],
)

# Real (good) + synthetic (bad) recorded traces plus the shared StepTxn.tla base
# the generated modules INSTANCE. trace_good.json is emitted verbatim by the
# graduated DTensor mesh simulation (//ferric_continuum/tnsr:dtensor_trace_dump);
# trace_bad.json is the canonical illegal commit-after-failure observation.
filegroup(
    name = "trace_fixtures",
    srcs = [
        "StepTxn.tla",
        "trace_bad.json",
        "trace_good.json",
    ],
    visibility = ["//visibility:public"],
)

# Hermetic TLC model check: runs both mesh models with Bazel's own JDK
# (`$(JAVA)` from the current Java runtime toolchain) against the pinned
# `@tla2tools//jar`. No host `java` or `TLA_TOOLS_JAR` is required. The good
# model must complete cleanly; the bad model must surface the invariant
# violation. Tagged `manual` + `local-only` so CPU-only `bazel test //...` and
# the CI tag filters skip it unless explicitly requested (it needs network at
# fetch time and a JDK at run time).
py_test(
    name = "mesh_plan_tlc_test",
    srcs = ["tlc_bazel_test.py"],
    args = [
        "$(JAVA)",
        "$(location @tla2tools//jar)",
    ],
    data = [
        ":mesh_plan_models",
        "@bazel_tools//tools/jdk:current_java_runtime",
        "@tla2tools//jar",
    ],
    main = "tlc_bazel_test.py",
    tags = [
        "local-only",
        "manual",
    ],
    toolchains = ["@bazel_tools//tools/jdk:current_java_runtime"],
    deps = [
        "//tools:tla_check",
        "@rules_python//python/runfiles",
    ],
)

# Hermetic TLC model check for the Layer-0 step-transaction contract. Same
# hermetic scaffolding as mesh_plan_tlc_test, driving the StepTxn Good/Bad pair
# via the --good/--bad flags. StepTxnGood must complete cleanly (Inv +
# StepResolves); StepTxnBad must surface the NoMutationAfterAbort/VersionMonotone
# violation. Tagged manual + local-only for the same reasons as the mesh check.
py_test(
    name = "step_txn_tlc_test",
    srcs = ["tlc_bazel_test.py"],
    args = [
        "$(JAVA)",
        "$(location @tla2tools//jar)",
        "--good",
        "StepTxnGood",
        "--bad",
        "StepTxnBad",
    ],
    data = [
        ":step_txn_models",
        "@bazel_tools//tools/jdk:current_java_runtime",
        "@tla2tools//jar",
    ],
    main = "tlc_bazel_test.py",
    tags = [
        "local-only",
        "manual",
    ],
    toolchains = ["@bazel_tools//tools/jdk:current_java_runtime"],
    deps = [
        "//tools:tla_check",
        "@rules_python//python/runfiles",
    ],
)

# Hermetic mesh-trace -> StepTxn refinement check (issue 08). Translates the
# recorded good/bad traces into StepTxn behavior modules and runs TLC on each:
# the good trace must refine StepTxn cleanly and the bad trace must violate
# TraceConsumed with a counterexample. Same hermetic scaffolding (Bazel $(JAVA)
# + pinned @tla2tools//jar) and the same manual + local-only tags as the other
# TLC checks (fetches the jar over the network at repo-rule time).
py_test(
    name = "trace_refine_tlc_test",
    srcs = ["trace_refine_bazel_test.py"],
    args = [
        "$(JAVA)",
        "$(location @tla2tools//jar)",
        "--good",
        "trace_good.json",
        "--bad",
        "trace_bad.json",
    ],
    data = [
        ":trace_fixtures",
        "@bazel_tools//tools/jdk:current_java_runtime",
        "@tla2tools//jar",
    ],
    main = "trace_refine_bazel_test.py",
    tags = [
        "local-only",
        "manual",
    ],
    toolchains = ["@bazel_tools//tools/jdk:current_java_runtime"],
    deps = [
        ":trace_bridge",
        "//tools:tla_check",
        "@rules_python//python/runfiles",
    ],
)
