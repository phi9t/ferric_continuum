{
  "workspace": {
    "primary_repo": "ferric_continuum",
    "repos": {
      "ferric_continuum": {
        "host": "repo://self",
        "sandbox": "/workspace/ferric_continuum",
        "mode": "rw",
        "required": true
      },
      "modular": {
        "host": "${HOME}/workspace/modular",
        "sandbox": "/workspace/modular",
        "mode": "ro",
        "required": false
      },
      "torchtitan": {
        "host": "${HOME}/workspace/torchtitan",
        "sandbox": "/workspace/torchtitan",
        "mode": "ro",
        "required": false
      },
      "monarch": {
        "host": "${HOME}/workspace/monarch",
        "sandbox": "/workspace/monarch",
        "mode": "ro",
        "required": false
      },
      "nccl": {
        "host": "${HOME}/workspace/nccl",
        "sandbox": "/workspace/nccl",
        "mode": "ro",
        "required": false
      },
      "cutlass": {
        "host": "${HOME}/workspace/cutlass",
        "sandbox": "/workspace/cutlass",
        "mode": "ro",
        "required": false
      }
    }
  }
}
